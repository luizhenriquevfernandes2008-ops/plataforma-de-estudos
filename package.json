    "@electron/packager": "20.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/luizhenriquevfernandes2008-ops/plataforma-de-estudos.git"
